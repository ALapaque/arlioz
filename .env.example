# Contact form delivery (Resend — https://resend.com). Without these, the form
# tells visitors to e-mail contact@arlioz.be directly.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@arlioz.be
# Must be a verified sender on Resend. Defaults to the Resend sandbox sender.
CONTACT_FROM_EMAIL="Arlioz <contact@arlioz.be>"
